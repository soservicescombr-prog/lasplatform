# netguard/.env.example
# ============================================================
# NetGuard - Variáveis de Ambiente
# Copie para .env e ajuste os valores para seu ambiente.
# ============================================================

# === App ===
APP_NAME=NetGuard
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# === Server ===
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Database (PostgreSQL) ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=netguard
DB_USER=netguard
DB_PASSWORD=NetGuard2026
# Ou defina a URL completa (sobrescreve os campos acima):
# DATABASE_URL=postgresql+asyncpg://netguard:senha@postgres:5432/netguard

# === Redis (Cache + Celery Broker) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === JWT Auth ===
# IMPORTANTE: Gere uma chave segura! Ex: openssl rand -hex 32
SECRET_KEY=03c051732abd545da7404e8a43c1fa34d794bba242efde7a3ec92e86ba606a8d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === SMTP (Notificações por e-mail) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=app-password-aqui
SMTP_FROM_EMAIL=netguard@seudominio.com
SMTP_TLS=true

# === Scan ===
DEFAULT_SCAN_TIMEOUT=600
MAX_CONCURRENT_SCANS=5
NMAP_PATH=/usr/bin/nmap
SCHEDULE_TIMEZONE=America/Sao_Paulo

# === NVD/CVE API (National Vulnerability Database) ===
# Obtenha em: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=893DB2FF-AA7A-474D-8E0E-35C62C2D7178
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# === Threat Intelligence (S5) ===
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=432f3aa24e2f9711c2727f1b0d1128a3015f6e8406957a117fa6dee82b579890
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=yb2b47e854b50af7520b5f2d2801033e757ab4bf6aa9307d7e4d48aead91930fb99cb8a98981698a0

# === Syslog Receiver (S10) ===
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=514
SYSLOG_EXTERNAL_PORT=514
SYSLOG_UDP_ENABLED=true
SYSLOG_TCP_ENABLED=true
SYSLOG_RETENTION_DAYS=30

# === Agent ===
AGENT_TOKEN_EXPIRE_DAYS=365
AGENT_HEARTBEAT_INTERVAL=15
AGENT_OFFLINE_SECONDS=180
#DEVICE_OFFLINE_FAILURES=3
METRICS_RETENTION_DAYS=30
BASELINE_MIN_SAMPLES=30
BASELINE_SIGMA=3.0
BASELINE_MIN_EXCESS_PERCENT=10.0
BASELINE_WINDOW_MINUTES=5
BASELINE_MIN_OCCURRENCES=10
BASELINE_MIN_SPAN_SECONDS=180

# === SNMP limits ===
SNMP_REQUEST_TIMEOUT_SECONDS=3
SNMP_REQUEST_RETRIES=1
SNMP_DEVICE_TIMEOUT_SECONDS=180


# === PostgreSQL Container ===
POSTGRES_DB=netguard
POSTGRES_USER=netguard
POSTGRES_PASSWORD=NetGuard2026
